FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

ENV NUGET_FALLBACK_PACKAGES=""

COPY ["TenderGo.Subscriber/TenderGo.Subscriber.csproj", "TenderGo.Subscriber/"]
COPY ["TenderGo.Services/TenderGo.Services.csproj", "TenderGo.Services/"]
COPY ["TenderGo.Models/TenderGo.Models.csproj", "TenderGo.Models/"]
COPY ["TenderGo.Contracts/TenderGo.Contracts.csproj", "TenderGo.Contracts/"]

RUN dotnet restore "TenderGo.Subscriber/TenderGo.Subscriber.csproj"

COPY . .

FROM build AS publish
WORKDIR "/src/TenderGo.Subscriber"
RUN dotnet publish "TenderGo.Subscriber.csproj" -c Release -o /app/publish --no-restore

FROM base AS final
WORKDIR /app
RUN adduser --disabled-password --gecos "" appuser && chown -R appuser /app
USER appuser
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "TenderGo.Subscriber.dll"]